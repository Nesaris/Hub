# Copie ce fichier en .env puis adapte. Une valeur fausse arrête le Hub au
# démarrage avec la liste des erreurs : rien ne part avec un réglage à moitié.

# Adresse par laquelle les services joignent le Hub (webhooks).
# Services sur le même Docker : http://hub:8100
# Services sur d'autres machines : l'adresse du Hub vue depuis ton réseau.
HUB_PUBLIC_URL=http://hub:8100

# Port publié sur 127.0.0.1 : on y accède par un tunnel SSH, ou par un relais
# HTTPS (Caddy, Traefik, Relay) posé devant.
HUB_BIND_PORT=8100
# Publier le Hub sur le réseau (0.0.0.0 ou l'IP de la machine) : il le sert
# alors lui-même en HTTPS, avec le certificat de secrets/tls/ (créé par
# « sh outils/tls-local.sh NOM IP »), et refuse de démarrer sans lui.
# HUB_TLS_NOM : le nom de ce certificat. Le Hub s'ouvre aussi par l'adresse IP
# (au TOTP : les clés d'accès ne s'ouvrent que sur un nom).
HUB_BIND_IP=127.0.0.1
HUB_TLS_NOM=
# IPv4 de la machine, inscrite au certificat (renouvelé chaque jour par hub-certificat).
HUB_TLS_IP=

# Registre d'extensions par défaut (le registre local livré est toujours ajouté)
HUB_REGISTRY=github-user:CodexX64

# Les noms des services (HTTPS, tunnel Cloudflare) : extension Relay, installée
# depuis le catalogue. Le Hub la pilote ; rien à poser ici.

# Rétention des mesures de sondes (jours)
HUB_PROBE_RETENTION_DAYS=7

# debug | info | warn | error — le journal de sécurité part toujours.
HUB_LOG_LEVEL=info

# Plafonds de l'IA, toutes connexions confondues, sur 24 heures glissantes :
# au-delà, l'assistant, les workflows et la mémoire reçoivent un refus (429)
# jusqu'à ce que la fenêtre se libère. Pose aussi un plafond de dépense chez
# chaque fournisseur payant : c'est lui qui tient si le Hub se trompe.
HUB_IA_APPELS_JOUR=3000
HUB_IA_JETONS_JOUR=2000000
# Jetons de réponse au plus, par appel.
HUB_IA_JETONS_MAX=8192

# Les clés maîtresses (HUB_CLE, SOCLE_CLE) ne vont pas ici : install.sh les
# crée dans secrets/, montées en secrets Docker par compose.yml.

# ---- Comptes (socle commun) ----
# Jeton exigé pour créer le premier compte. Vide : tiré au démarrage et écrit
# dans les journaux du conteneur (docker compose logs hub).
SOCLE_JETON_INSTALLATION=
# Relais HTTPS de confiance devant le Hub (CIDR) : seuls eux peuvent dire
# l'adresse du client et que la connexion est chiffrée. Ex. 172.16.0.0/12
SOCLE_PROXYS=
# 1 : mode HTTP dégradé (aucune clé d'accès nulle part, bandeau permanent).
# Inutile pour ouvrir le Hub par son adresse IP : il le voit seul et prend
# mot de passe + TOTP ; la clé se crée par le nom en HTTPS ou sur localhost.
SOCLE_HTTP=0
# Où signaler une faille (/.well-known/security.txt) : https:// ou mailto:
SOCLE_CONTACT_SECURITE=

# ---- Alertes de sécurité par courriel (facultatif) ----
# Adresse publique du Hub (https://…) : les liens des courriels en partent.
SOCLE_URL_PUBLIQUE=
SOCLE_SMTP_HOTE=
SOCLE_SMTP_PORT=465
SOCLE_SMTP_SECURITE=tls
SOCLE_SMTP_UTILISATEUR=
SOCLE_SMTP_MOTDEPASSE=
SOCLE_SMTP_DE=
